generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  icon        String
  title       String
  description String
  isExpertise Boolean?  @map("is_expertise")
  isActive    Boolean?  @map("is_active")
  badges      Badge[]
  projects    Project[]
  stats       Stats[]

  @@map("category")
}

model Tag {
  id       Int          @id @default(autoincrement())
  title    String
  projects ProjectTag[]

  @@map("tag")
}

model Project {
  id               Int            @id @default(autoincrement())
  title            String
  shortDescription String?        @map("short_description")
  description      String
  imagePath   String         @map("image_path")
  isActive    Boolean        @default(true) @map("is_active")
  categoryId  Int            @map("category_id")
  category    Category       @relation(fields: [categoryId], references: [id])
  media       ProjectMedia[]
  tags        ProjectTag[]

  @@map("project")
}

model ProjectTag {
  id        Int     @id @default(autoincrement())
  tagId     Int     @map("tag_id")
  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@map("project_tag")
}

model ProjectMedia {
  id        Int     @id @default(autoincrement())
  imageUrl  String  @map("image_url")
  projectId Int     @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_media")
}

model Issuer {
  id        Int     @id @default(autoincrement())
  name      String
  imagePath String  @map("image_path")
  badges    Badge[]

  @@map("issuer")
}

model Badge {
  id          Int      @id @default(autoincrement())
  title         String
  description   String
  imagePath     String   @map("image_path")
  credentialUrl String?  @map("credential_url")
  isActive      Boolean  @default(true) @map("is_active")
  categoryId  Int      @map("category_id")
  issuerId    Int?     @map("issuer_id")
  category    Category @relation(fields: [categoryId], references: [id])
  issuer      Issuer?  @relation(fields: [issuerId], references: [id])

  @@map("badge")
}

model Contact {
  id      Int    @id @default(autoincrement())
  name    String
  email   String
  subject String
  message String

  @@map("contact")
}

model Stats {
  id         Int      @id @default(autoincrement())
  categoryId Int      @map("category_id")
  percentage Decimal
  isActive   Boolean  @default(true) @map("is_active")
  category   Category @relation(fields: [categoryId], references: [id])

  @@map("stats")
}